<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dgml SYSTEM "http://edu.kde.org/marble/dgml/2.0/dgml.dtd">
<dgml xmlns="http://edu.kde.org/marble/dgml/2.0">
  <document>

    <head>
      <license short="© 天地图 / National Platform for Common Geospatial Information Services">
        Tiles © Tianditu (tianditu.gov.cn). Usage requires a registered developer key (tk).
      </license>
      <name>Tianditu (China, vector)</name>
      <target>earth</target>
      <theme>tianditu-en</theme>
      <icon pixmap="tianditu-en-preview.png"/>
      <visible>true</visible>
      <description><![CDATA[
        Tianditu vector basemap + Chinese annotation (cva). Web Mercator,
        CGCS2000 ≈ WGS-84. Now uses the Chinese (cva) label layer for full coverage;
        the English (eva) layer is sparse away from major cities.
        Replace YOUR_TIANDITU_KEY with your registered tk.
      ]]></description>
      <zoom>
        <minimum>900</minimum>
        <maximum>3500</maximum>
        <discrete>false</discrete>
      </zoom>
    </head>

    <map bgcolor="#000000">
      <canvas/>
      <target/>

      <layer name="tianditu-en" backend="texture">

        <!-- Base vector tiles (shared cache with the tianditu theme) -->
        <texture name="tianditu_vec" expire="31536000">
          <sourcedir format="PNG"> earth/tianditu </sourcedir>
          <tileSize width="256" height="256"/>
          <storageLayout levelZeroColumns="1" levelZeroRows="1"
                         maximumTileLevel="18" mode="Custom"/>
          <projection name="Mercator"/>
          <downloadUrl protocol="https" host="t0.tianditu.gov.cn" path="/vec_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=vec&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadUrl protocol="https" host="t1.tianditu.gov.cn" path="/vec_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=vec&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadUrl protocol="https" host="t2.tianditu.gov.cn" path="/vec_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=vec&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadUrl protocol="https" host="t3.tianditu.gov.cn" path="/vec_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=vec&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadUrl protocol="https" host="t4.tianditu.gov.cn" path="/vec_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=vec&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadUrl protocol="https" host="t5.tianditu.gov.cn" path="/vec_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=vec&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadUrl protocol="https" host="t6.tianditu.gov.cn" path="/vec_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=vec&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadUrl protocol="https" host="t7.tianditu.gov.cn" path="/vec_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=vec&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadPolicy usage="Browse" maximumConnections="8"/>
          <downloadPolicy usage="Bulk" maximumConnections="2"/>
        </texture>

        <!-- Chinese annotation overlay (cva): full coverage. For English use /eva_w + LAYER=eva. -->
        <texture name="tianditu_cva" expire="31536000">
          <sourcedir format="PNG"> earth/tianditu-labels-cn </sourcedir>
          <tileSize width="256" height="256"/>
          <storageLayout levelZeroColumns="1" levelZeroRows="1"
                         maximumTileLevel="18" mode="Custom"/>
          <projection name="Mercator"/>
          <blending name="AlphaBlending"/>
          <downloadUrl protocol="https" host="t0.tianditu.gov.cn" path="/cva_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=cva&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadUrl protocol="https" host="t1.tianditu.gov.cn" path="/cva_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=cva&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadUrl protocol="https" host="t2.tianditu.gov.cn" path="/cva_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=cva&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadUrl protocol="https" host="t3.tianditu.gov.cn" path="/cva_w/wmts"
            query="SERVICE=WMTS&amp;REQUEST=GetTile&amp;VERSION=1.0.0&amp;LAYER=cva&amp;STYLE=default&amp;TILEMATRIXSET=w&amp;FORMAT=tiles&amp;TILEMATRIX={zoomLevel}&amp;TILEROW={y}&amp;TILECOL={x}&amp;tk=YOUR_TIANDITU_KEY"/>
          <downloadPolicy usage="Browse" maximumConnections="8"/>
          <downloadPolicy usage="Bulk" maximumConnections="2"/>
        </texture>

      </layer>
    </map>

    <settings>
      <property name="coordinate-grid">
        <value>true</value>
        <available>true</available>
      </property>
      <property name="overviewmap">
        <value>true</value>
        <available>true</available>
      </property>
      <property name="scalebar">
        <value>true</value>
        <available>true</available>
      </property>
    </settings>

    <legend>
      <section name="tianditu-en" checkable="false" spacing="12">
        <heading>Tianditu (Vector)</heading>
      </section>
    </legend>

  </document>
</dgml>
