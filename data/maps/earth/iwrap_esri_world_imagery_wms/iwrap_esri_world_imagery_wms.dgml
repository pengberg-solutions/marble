<?xml version="1.0" encoding="UTF-8"?>
<dgml xmlns="http://edu.kde.org/marble/dgml/2.0">
    <document>

        <head>
            <name>Esri World Imagery + IWRAP WMS</name>
            <target>earth</target>
            <theme>iwrap_esri_world_imagery_wms</theme>
            <icon pixmap="iwrap_esri_world_imagery_wms-preview.png"/>
            <visible>true</visible>
            <description><![CDATA[
                <p>Composite theme stacking Esri World Imagery (base) with IWRAP's
                runtime-configured WMS overlay (top).</p>
                <p>Esri imagery provides a global satellite/aerial basemap.
                The WMS overlay's URL is injected at runtime by
                IwrapWmsServerLayout; this DGML uses a placeholder host.</p>
            ]]></description>
            <zoom>
                <minimum>   900  </minimum>
                <maximum>  4000  </maximum>
                <discrete> false </discrete>
            </zoom>
        </head>

        <map bgcolor="#000000">
            <canvas/>
            <target/>

            <layer name="esriworldimagery" backend="texture">
                <texture name="esri_world_imagery_data" expire="2592000">
                    <sourcedir format="JPG"> earth/esri_world_imagery </sourcedir>
                    <tileSize width="256" height="256"/>
                    <storageLayout levelZeroColumns="1"
                                   levelZeroRows="1"
                                   maximumTileLevel="19"
                                   mode="Custom"/>
                    <projection name="Mercator"/>
                    <downloadUrl protocol="https"
                                 host="server.arcgisonline.com"
                                 path="/ArcGIS/rest/services/World_Imagery/MapServer/tile/{zoomLevel}/{y}/{x}"/>
                    <downloadPolicy usage="Browse" maximumConnections="8"/>
                    <downloadPolicy usage="Bulk" maximumConnections="2"/>
                </texture>
            </layer>

            <layer name="iwrap_wms" backend="texture">
                <!--
                    iwrap_wms_data: IWRAP's WMS overlay layer.
                    The downloadUrl host is a placeholder using RFC 2606's
                    reserved .invalid TLD; the actual per-tile URL is
                    generated at runtime by IwrapWmsServerLayout::downloadUrl
                    from the user-configured WmsSettings.
                    AlphaBlending + default opacity 1.0 — runtime-adjustable
                    via the IWRAP WMS Layers transparency slider (Path X API).
                -->
                <texture name="iwrap_wms_data" expire="604800">
                    <sourcedir format="PNG"> earth/iwrap_wms </sourcedir>
                    <tileSize width="256" height="256"/>
                    <storageLayout levelZeroColumns="1"
                                   levelZeroRows="1"
                                   maximumTileLevel="19"
                                   mode="Custom"/>
                    <projection name="Mercator"/>
                    <downloadUrl protocol="http"
                                 host="placeholder.example.invalid"
                                 path="/"/>
                    <blending name="AlphaBlending"/>
                    <opacity value="1.0"/>
                </texture>
            </layer>
        </map>

        <settings>
            <property name="coordinate-grid">
                <value>true</value>
                <available>true</available>
            </property>
            <property name="overviewmap">
                <value>true</value>
                <available>true</available>
            </property>
            <property name="compass">
                <value>true</value>
                <available>true</available>
            </property>
            <property name="scalebar">
                <value>true</value>
                <available>true</available>
            </property>
            <group name="Places">
                <property name="places">
                    <value>false</value>
                    <available>false</available>
                </property>
                <property name="otherplaces">
                    <value>false</value>
                    <available>false</available>
                </property>
            </group>
        </settings>

        <legend>
            <section name="coordinate-grid" checkable="true" connect="coordinate-grid" spacing="12">
                <heading>Coordinate Grid</heading>
            </section>
        </legend>

    </document>
</dgml>